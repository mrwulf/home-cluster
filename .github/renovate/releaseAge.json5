{
  packageRules: [
    {
      description: "Core infra: let releases soak 3 days before they are mergeable",
      matchPackageNames: [
        "/pocket-id/",
        "/rook/",
        "/ceph/",
        "/traefik/",
        "/cloudnative-pg/",
        "/cnpg/",
        "/cert-manager/",
        "/kyverno/",
        "/external-secrets/",
        "/volsync/",
        "/vaultwarden/",
      ],
      minimumReleaseAge: "3 days",
    },
    {
      description: "LifeOS agent image: it runs third-party code with the agent's credentials, so releases soak a week",
      matchFileNames: [
        ".github/lifeos-agent/Dockerfile",
        ".github/workflows/lifeos-agent-image.yaml",
      ],
      matchDatasources: ["docker", "npm"],
      minimumReleaseAge: "7 days",
    },
  ],
  // Open aged PRs right away with a pending renovate/stability-days check so they stay visible.
  // Only affects updates that have a minimumReleaseAge (these rules and cilium).
  internalChecksFilter: "none",
}
