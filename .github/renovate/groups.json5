{
  packageRules: [
    {
      description: "Rook-Ceph image and chart",
      groupName: "Rook Ceph",
      matchPackageNames: ["/rook\\.ceph/", "/rook\\/rook/"],
      matchDatasources: ["docker", "helm", "github-tags"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
      separateMinorPatch: true,
    },
    {
      description: "Intel Device Plugin",
      groupName: "Intel Device Plugin",
      matchPackageNames: [
        "/intel-device-plugins-operator/",
        "/intel-device-plugins-gpu/",
      ],
      matchDatasources: ["helm", "regex", "github-tags"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
      separateMinorPatch: true,
    },
    {
      description: "Traefik chart and CRD",
      groupName: "Traefik",
      matchPackageNames: ["/traefik/", "/traefik-crd-source/"],
      matchDatasources: ["helm", "regex", "github-tags"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
      separateMinorPatch: true,
    },
    {
      matchDatasources: ["helm", "docker"],
      matchPackageNames: [
        "quay.io/cilium/cilium",
        "quay.io/cilium/operator-generic",
        "cilium",
      ],
      groupName: "cilium",
      additionalBranchPrefix: "",
      separateMinorPatch: true,
      minimumReleaseAge: "2 days",
    },
    {
      description: "External Snapshotter image and kustomization",
      groupName: "External Snapshotter",
      matchPackageNames: ["/external-snapshotter/", "/snapshot-controller/"],
      matchDatasources: ["docker", "github-tags"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
      separateMinorPatch: true,
    },
    {
      description: "Immich images",
      groupName: "Immich",
      matchPackageNames: ["/immich/"],
      matchDatasources: ["docker"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      separateMinorPatch: true,
    },
    {
      description: "Vector image and chart - versions do not match",
      groupName: "Vector",
      matchPackageNames: ["/vector/"],
      matchDatasources: ["docker", "github-releases", "helm"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
      separateMinorPatch: false,
    },
    {
      description: "Vikunja images",
      groupName: "Vikunja",
      matchPackageNames: ["/vikunja/"],
      matchDatasources: ["docker"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
      separateMinorPatch: true,
    },
    {
      description: "FRP client and server",
      groupName: "FRP",
      matchPackageNames: [
        "/fatedier\\/frp/",
        "/fatedier\\/frpc/",
        "/docker\\.io\\/fatedier\\/frpc/",
      ],
      matchDatasources: ["docker", "github-releases"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
      separateMinorPatch: true,
    },
    {
      description: "Talos and tuppr upgrades",
      groupName: "Talos",
      matchPackageNames: [
        "siderolabs/talos",
        "ghcr.io/siderolabs/installer",
        "ghcr.io/siderolabs/talos",
        "ghcr.io/siderolabs/talosctl",
        "/siderolabs\\/talos/",
        "/siderolabs\\/installer/",
        "/siderolabs\\/talosctl/",
      ],
      matchDatasources: ["custom.talos-factory", "docker", "github-releases"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
      separateMinorPatch: true,
    },
    {
      description: "NetBird control plane and client components",
      groupName: "NetBird",
      matchPackageNames: [
        "docker.io/netbirdio/management",
        "docker.io/netbirdio/signal",
        "docker.io/netbirdio/relay",
        "docker.io/netbirdio/dashboard",
        "ghcr.io/netbirdio/netbird",
        "netbird-operator",
        "netbirdio/netbird",
        "/netbird/",
        "/netbirdio\\//",
      ],
      matchDatasources: ["docker", "github-releases", "helm"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
      separateMinorPatch: true,
    },
    {
      description: "Kubernetes and tuppr upgrades",
      groupName: "Kubernetes",
      matchPackageNames: [
        "ghcr.io/siderolabs/kubelet",
        "kubernetes/kubernetes",
        "registry.k8s.io/kube-apiserver",
        "registry.k8s.io/kube-controller-manager",
        "registry.k8s.io/kube-scheduler",
        "registry.k8s.io/kube-proxy",
        "/siderolabs\\/kubelet/",
        "/kubernetes\\/kubernetes/",
      ],
      matchDatasources: ["docker", "github-releases"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
      separateMinorPatch: true,
    },
  ],
}
